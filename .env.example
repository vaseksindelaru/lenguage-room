# ── Environment Variables ──
# Copy this to .env and fill in your values
# NEVER commit the real .env to git!

# Discord Bot Token (from Discord Developer Portal > Bot)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# OpenRouter API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cerebras API Key (from https://cloud.cerebras.ai)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Groq API Key (from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Discord Channel ID (right-click channel > Copy ID, needs Developer Mode)
CHANNEL_ID=1523161377747763342

# Vaclav's Discord User ID (for special handling/corrections)
VACLAV_USER_ID=1458317824299892746

# Model to use for agent conversations
# Recommended free options:
#   meta-llama/llama-3.3-70b-instruct:free (via OpenRouter)
#   llama-3.3-70b (via Cerebras)
#   llama-3.1-8b-instant (via Groq)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free