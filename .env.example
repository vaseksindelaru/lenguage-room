# ── KRK-9 Environment Variables ──
# Copy this to .env and fill in your values
# NEVER commit the real .env to git!

# ── Discord Configuration ──────────────────────────────
# Get these from Discord Developer Portal (https://discord.com/developers/)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_channel_id_here
GUILD_ID=your_guild_server_id_here
VACLAV_USER_ID=your_discord_user_id_here  # The main user (for tutor corrections)

# ── LLM Providers (at least one required) ──────────
# Local LLM (free, private, requires Ollama installed)
OLLAMA_URL=http://localhost:11434

# Free-tier API keys (no credit card required)
CEREBRAS_API_KEY=your_cerebras_api_key_here      # From https://cloud.cerebras.ai
GROQ_API_KEY=your_groq_api_key_here            # From https://console.groq.com
OPENROUTER_API_KEY=your_openrouter_api_key_here  # From https://openrouter.ai/keys

# ── Audio Server ─────────────────────────────────────
# Discord webhook for voice messages (optional, auto-configured by bot)
DISCORD_VOICE_WEBHOOK_URL=

# ── Model Configuration ─────────────────────────────
# Which model to use (only if using OpenRouter)
# Recommended free options:
#   meta-llama/llama-3.3-70b-instruct:free (via OpenRouter)
#   llama-3.3-70b (via Cerebras)
#   llama-3.1-8b-instant (via Groq)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Customization ──────────────────────────────────
# Path to your custom logo (relative to static/ folder)
LOGO_PATH=/static/logo.png

# Primary color for UI (hex code, without "#")
PRIMARY_COLOR=5865f2

# App name (shown if logo fails to load)
APP_NAME=KRK-9
